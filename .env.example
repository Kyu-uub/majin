/* Majin — sample configuration.
   Copy this file to ".env" (same folder) and fill in the values you need. The app
   reads ".env" at startup. You only need ONE provider key to talk to Majin; add the
   others if you want the automatic rate-limit failover between providers.

   NEVER commit your real ".env" — it is listed in .gitignore on purpose. This
   .env.example is the only config file that is safe to publish. */

# --- Provider API keys (get one free key to start) ---
# Google Gemini — https://aistudio.google.com/app/apikey  (recommended: it can also see images for Vision)
GEMINI_API_KEY=

# Groq — https://console.groq.com/keys  (fast, free tier)
GROQ_API_KEY=

# FreeLLMAPI unified key + base URL (optional — a local/free model pool)
FREELLMAPI_API_KEY=
FREELLMAPI_BASE_URL=

# --- Defaults for first run (optional) ---
# Which provider to start on: gemini | groq | freellm
MAJIN_PROVIDER=gemini
# Leave blank to use the provider's default model, or set an exact model id.
MAJIN_MODEL=

# Local server port for `npm start`. The desktop app picks a free port automatically
# if this one is taken, so you rarely need to change it.
PORT=3000
